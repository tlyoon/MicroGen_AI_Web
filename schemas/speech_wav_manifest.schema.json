{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-speech-segment final PCM WAV inputs v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "segment_id",
      "filename",
      "speech_sha256",
      "voice_id",
      "pause_after_ms"
    ],
    "properties": {
      "segment_id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
      },
      "filename": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+\\.wav$"
      },
      "speech_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "voice_id": {
        "type": "string",
        "minLength": 1
      },
      "pause_after_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1500
      }
    }
  }
}
