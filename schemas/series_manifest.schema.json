{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroGen series QA and publication manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lesson_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "part_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
          },
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "planned",
              "running",
              "review_required",
              "blocked",
              "passed",
              "published"
            ]
          },
          "mp4_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_s": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "qa_receipt_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "part_id",
          "index",
          "status",
          "mp4_sha256",
          "duration_s",
          "qa_receipt_sha256"
        ]
      }
    },
    "overall_status": {
      "enum": [
        "planned",
        "running",
        "review_required",
        "blocked",
        "passed",
        "published"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "lesson_plan_sha256",
    "profile",
    "parts",
    "overall_status"
  ]
}
