{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified rendered PDF element rectangles v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "instrumented_pdf_sha256",
    "storyboard_sha256",
    "pages",
    "elements",
    "unverified"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "rendered_geometry_verified_visual_content_unreviewed"
    },
    "instrumented_pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storyboard_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "page_index",
          "width_pt",
          "height_pt",
          "rotation"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "page_index": {
            "type": "integer",
            "minimum": 0
          },
          "width_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id",
          "slide_id",
          "page_index",
          "rect_pt",
          "rect_norm"
        ],
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "slide_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "page_index": {
            "type": "integer",
            "minimum": 0
          },
          "rect_pt": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "rect_norm": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
