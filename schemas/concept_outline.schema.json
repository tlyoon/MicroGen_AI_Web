{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroGen editable source-anchored concept outline v1 (unreviewed or approved)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "included_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "excluded_pages": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "page",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "included_pages",
        "excluded_pages"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "approved"
          ]
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 3
        },
        "coverage_note": {
          "type": "string",
          "minLength": 15
        }
      },
      "required": [
        "status",
        "reviewed_by",
        "coverage_note"
      ],
      "additionalProperties": false
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "kind": {
                      "const": "text"
                    },
                    "excerpt": {
                      "type": "string",
                      "minLength": 12
                    }
                  },
                  "required": [
                    "page",
                    "kind",
                    "excerpt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "kind": {
                      "const": "visual_reviewed"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 12
                    }
                  },
                  "required": [
                    "page",
                    "kind",
                    "description"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "kind": {
                      "const": "visual_unreviewed"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 12
                    }
                  },
                  "required": [
                    "page",
                    "kind",
                    "description"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "estimated_teaching_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3600
          },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            }
          },
          "boundary_after": {
            "enum": [
              "preferred",
              "allowed",
              "forbidden"
            ]
          },
          "planned_slides": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "concept_id",
          "title",
          "source_pages",
          "evidence",
          "estimated_teaching_s",
          "prerequisites",
          "boundary_after",
          "planned_slides"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "profile",
    "title",
    "scope",
    "approval",
    "concepts"
  ],
  "additionalProperties": false
}
