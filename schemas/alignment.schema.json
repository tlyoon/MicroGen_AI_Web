{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroGen audio-verified highlight event timeline v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "part_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
    },
    "slide_pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storyboard_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
          },
          "segment_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
          },
          "element_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
            }
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "timing_method": {
            "enum": [
              "tts_provider",
              "speech_segment",
              "forced_alignment"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "slide_id",
          "segment_id",
          "element_ids",
          "start_ms",
          "end_ms",
          "timing_method",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "part_id",
    "slide_pdf_sha256",
    "audio_sha256",
    "storyboard_sha256",
    "duration_ms",
    "events"
  ]
}
